{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/notifications/cron?type=morning",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/notifications/cron?type=night",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/notifications/cron?type=overdue",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/notifications/cron?type=inactivity",
      "schedule": "30 6 * * *"
    }
  ]
}
