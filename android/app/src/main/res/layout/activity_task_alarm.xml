<?xml version="1.0" encoding="utf-8"?>
<!--
  صفحه‌ی آلارم تسک.

  این صفحه کاملاً نیتیو است و هیچ وابستگی‌ای به WebView، اینترنت یا نشستِ ورود
  ندارد؛ به همین دلیل می‌تواند وقتی اپ بسته است و صفحه قفل است هم نمایش داده شود.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:letterSpacing="0.08"
        android:text="آلارم کار"
        android:textColor="#93C5FD"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textColor="#F8FAFC"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text=""
        android:textColor="#CBD5E1"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/alarm_snooze"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="تعویق ۵ دقیقه"
            android:textSize="16sp" />

        <Button
            android:id="@+id/alarm_stop"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="توقف"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
