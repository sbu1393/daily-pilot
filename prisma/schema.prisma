generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  HIGH
  LOW
  MEDIUM
}

enum CalendarType {
  JALALI
  GREGORIAN
}

enum UserPlan {
  FREE
  PRO
}

// فاز ۴ — نقش کاربر؛ کاملاً مستقل از UserPlan (Role ≠ Plan، سند §Locked)
enum UserRole {
  USER
  ADMIN
}

enum TaskEventType {
  CREATED
  ANALYZED
  EDITED
  ROLLED_OVER
  COMPLETED
}

// فاز ۱ — پریود کووتا AI (فقط ماهانه)
enum AiUsagePeriodType {
  MONTHLY
}

// فاز ۱ — چرخه‌ی حیات رویداد مصرف AI
enum AiUsageEventStatus {
  RESERVED
  CONSUMED
  RELEASED
}

// فاز ۵ — ارائه‌دهنده‌ی پرداخت (سند §3.1؛ فقط providerهای واقعاً پیاده‌شده)
enum BillingProvider {
  ZARINPAL
}

// فاز ۵ — وضعیت سفارش پرداخت (سند §3.2)؛ حالت‌های نهایی: PAID/FAILED/EXPIRED/CANCELED
enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
}

// فاز ۵ — وضعیت دوره‌ی دسترسی کاربر (سند §3.3)
enum EntitlementStatus {
  ACTIVE
  EXPIRED
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  email         String         @unique
  password      String
  firstName     String?
  lastName      String?
  birthDate     DateTime?
  phone         String?
  image         String?
  timezone      String         @default("Asia/Tehran")
  locale        String         @default("fa")
  calendar      CalendarType   @default(JALALI)
  plan          UserPlan       @default(FREE)
  // فاز ۴ — role از DB خوانده می‌شود (هرگز داخل JWT نمی‌رود؛ revocation فوری)
  role          UserRole       @default(USER)
  lastSeenAt    DateTime? // فاز ۱ — آخرین فعالیت احرازهویت‌شده (throttle 30 دقیقه)
  tasks         Task[]
  dailyPlans    DailyPlan[]
  aiUsages      AiUsage[]
  aiUsageEvents AiUsageEvent[]
  productEvents ProductEvent[] // فاز ۳ — رویدادهای تحلیلی محصول
  paymentOrders PaymentOrder[] // فاز ۵ — تاریخچه‌ی تلاش‌های پرداخت
  entitlement   Entitlement? // فاز ۵ — دوره‌ی دسترسی فعلی (یکتا per user)
  // یادآورها — آینه‌ی سرور برنامه‌ی یادآور کاربر (تنظیمات UI در localStorage
  // است، ولی برای ارسال Push در زمان مقرر سرور باید زمان‌بندی را بداند)
  reminderEnabled Boolean @default(false) // آیا یادآور فعال است؟
  reminderTime    String  @default("09:00") // "HH:MM" به وقت محلی کاربر
  reminderSentOn  String? // dayKey محلیِ آخرین ارسال موفق (ضد ارسال تکراری)
  pushSubscriptions PushSubscription[] // یادآورها — اشتراک‌های Web Push این کاربر
}

model Task {
  id                    Int           @id @default(autoincrement())
  title                 String
  category              String?
  priority              TaskPriority?
  score                 Int? // 0 تا 100 — خروجی AI
  reason                String? // دلیل اولویت‌بندی — خروجی AI
  estimatedTime         Int? // تخمین خام AI (دقیقه) — ورودی موتور
  allocatedMinutes      Int? // سهم تخصیص‌یافته توسط موتور (دقیقه)
  spentMinutes          Int? // مدت واقعی اعلام‌شده هنگام DONE (دقیقه)
  scheduledDate         DateTime // لحظه‌ی نیمه‌شب محلیِ روز برنامه‌ریزی (absolute instant)
  dayKey                String // کلید روز canonical "YYYY-MM-DD" — سمت سرور از user.timezone محاسبه می‌شود (§6.2.2.1)
  previousScheduledDate DateTime? // برای تشخیص rollover
  status                TaskStatus    @default(TODO)
  completedAt           DateTime? // لحظه‌ی اتمام
  completedOn           String? // کلید جلالی روز اتمام → تاریخچه
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  userId                Int
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events                TaskEvent[]

  @@index([userId, dayKey])
  @@index([userId, status])
  @@index([userId, completedOn])
}

model DailyPlan {
  id                Int      @id @default(autoincrement())
  dayKey            String // کلید روز جلالی
  availableMinutes  Int      @default(0) // ظرفیت روز اعلام‌شده توسط کاربر
  userId            Int
  createdAt         DateTime @default(now())
  planVersion       Int      @default(0) // G-03: نسخهی برنامه — مبنای stale detection
  rebalancedVersion Int? // آخرین نسخهای که rebalance روی آن اجرا شده
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
}

model TaskEvent {
  id        String        @id @default(cuid())
  taskId    Int
  type      TaskEventType
  payload   Json?
  createdAt DateTime      @default(now())
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// فاز ۱ — ظرفیت ماهانه‌ی AI per user (source of truth quota)
model AiUsage {
  id            Int               @id @default(autoincrement())
  userId        Int
  periodType    AiUsagePeriodType @default(MONTHLY)
  periodStart   DateTime
  reservedUnits Int               @default(0)
  consumedUnits Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodType, periodStart])
  @@index([userId, periodStart])
}

// فاز ۲ — تاریخچه خطاهای عملیاتی (source of truth error history؛ fail-open telemetry)
model ErrorLog {
  id          String   @id @default(cuid())
  requestId   String
  userId      Int?
  endpoint    String
  feature     String?
  errorCode   String
  statusCode  Int
  category    String
  severity    String
  message     String
  stack       String?
  metadata    Json?
  environment String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([errorCode, createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
  @@index([endpoint, createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
}

// فاز ۳ — رویدادهای تحلیلی محصول (سند فاز ۳ §5) — مستقل از TaskEvent/AiUsageEvent/ErrorLog
model ProductEvent {
  id         String   @id @default(cuid())
  userId     Int
  requestId  String? // فقط correlation — غیر-unique، غیر-dedup (سند §13)
  eventName  String
  feature    String?
  properties Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventName, createdAt])
  @@index([createdAt])
}

// فاز ۱ — رویداد مصرف AI برای audit و idempotency (requestId = idempotency key)
model AiUsageEvent {
  id          Int                @id @default(autoincrement())
  requestId   String             @unique
  userId      Int
  feature     String
  model       String?
  units       Int                @default(1)
  status      AiUsageEventStatus
  attempts    Int                @default(1)
  failureCode String?
  durationMs  Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}

// فاز ۵ — سفارش پرداخت: source of truth «آیا پرداختی ساخته شد و چه شد» (سند §2/§3.4)
// snapshot مقادیر در زمان checkout (amount/currency/entitlementDays) — تغییر config نباید
// معنای سفارش ساخته‌شده را عوض کند. هیچ داده‌ی کارت/CVV/provider payload اینجا ذخیره نمی‌شود.
model PaymentOrder {
  id                     String             @id @default(cuid())
  userId                 Int
  provider               BillingProvider
  merchantOrderId        String             @unique
  checkoutIdempotencyKey String
  amount                 Int
  currency               String
  status                 PaymentOrderStatus
  providerAuthority      String?
  providerReference      String?
  entitlementDays        Int
  requestId              String? // فقط correlation (سند §22) — idempotency جدا از requestId است
  expiresAt              DateTime
  paidAt                 DateTime?
  failureCode            String?
  entitlementId          String? // ارجاع به Entitlement پس از finalize (بدون relation — سند §3.4)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkoutIdempotencyKey])
  @@unique([provider, providerAuthority])
  @@unique([provider, providerReference])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

// یادآورها — Web Push (VAPID): زیرساخت ارسال یادآور در حالت بسته بودن اپ/Doze.
// یک ردیف = یک endpoint مرورگر (کلید یکتای واقعی endpoint است، نه کاربر)؛
// `p256dh`/`auth` فقط برای رمزنگاری payload استفاده می‌شوند و هیچ داده‌ی هویتی
// یا محتوای تسک اینجا ذخیره نمی‌شود. جدول کاملاً additive است و هیچ ستونی از
// جدول‌های موجود را تغییر نمی‌دهد.
// توجه: `userId` مثل بقیه‌ی روابط این پروژه `Int` است (نه String) و با
// onDelete: Cascade به User وصل می‌شود تا حذف حساب، اشتراک‌های دستگاه را پاک کند.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    Int
  endpoint  String   @unique // PushSubscription.endpoint — فقط همین یکتا است
  p256dh    String // کلید عمومی کلاینت (Base64URL)
  auth      String // راز احراز‌هویت کلاینت (Base64URL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // آخرین (re)subscribe — مبنای prune سقف per user
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// فاز ۵ — Entitlement: source of truth «دوره‌ی دسترسی فعلی پرداخت‌شده» (سند §2/§3.5)
// فقط یک ردیف per user؛ منبع effective plan است (User.plan آینه‌ی آن است).
// عمداً بدون providerCustomerId/providerSubscriptionId/invoice/raw metadata/trial/cancelAtPeriodEnd.
model Entitlement {
  id                 String            @id @default(cuid())
  userId             Int               @unique
  provider           BillingProvider
  status             EntitlementStatus
  planCode           UserPlan
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
}
